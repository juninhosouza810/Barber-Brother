rules_version = '2';

// Regras padrão FECHADAS: nenhum acesso direto de clientes externos.
// O acesso ao Firestore deve passar pelo backend (Admin SDK) ou ser liberado
// aqui conforme a necessidade futura do app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
